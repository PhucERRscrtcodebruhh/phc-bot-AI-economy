# ========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO PHC BOT (KATBOT)
# ========================================================
# Sao chép file này thành .env và điền các khóa API tương ứng:
# cp .env.example .env

# [BẮT BUỘC] Token của bot Discord từ Discord Developer Portal
TOKEN=your_discord_bot_token_here

# [TÙY CHỌN] Danh sách Gemini API Keys từ Google AI Studio (ngăn cách bằng dấu phẩy để kích hoạt Load Balancer)
# https://aistudio.google.com/
GEMINI_KEYS=your_gemini_key_1,your_gemini_key_2

# [TÙY CHỌN] Khóa API OpenRouter (Dùng cho AI Moderation model openai/gpt-oss-safeguard-20b và các model OpenRouter)
# https://openrouter.ai/keys
OPENROUTER_KEY=your_openrouter_api_key_here

# [TÙY CHỌN] Khóa API Groq (Nhà cung cấp Groq siêu tốc: Llama 3.3 70B, Llama 3.1 8B...)
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# [TÙY CHỌN] Khóa API DeepSeek (Nhà cung cấp DeepSeek: deepseek-chat V3, deepseek-reasoner R1...)
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
